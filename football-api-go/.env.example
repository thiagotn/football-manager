# Application
APP_ENV=development
PORT=8080

# Database
DATABASE_URL=postgres://football:football@localhost:5433/football_dev?sslmode=disable

# JWT
SECRET_KEY=change-me-to-a-random-256-bit-secret

# Twilio Verify (OTP)
# Leave empty to use bypass mode (OTP code = "123456" for any number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Cloudflare R2 (avatar/media storage — served via R2_PUBLIC_BASE_URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rachao-media
R2_PUBLIC_BASE_URL=https://cdn.rachao.app

# Anthropic (AI chat)
ANTHROPIC_API_KEY=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
